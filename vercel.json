{
  "rewrites": [
    {
      "source": "/watch/:share_id*",
      "destination": "/api/watch?watch=:share_id*"
    },
    {
      "source": "/item/:share_id*",
      "destination": "/api/watch?watch=:share_id*"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "watch"
        }
      ],
      "destination": "/api/watch"
    }
  ]
}
